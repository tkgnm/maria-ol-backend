{
  "kind": "collectionType",
  "collectionName": "artwork_groups",
  "info": {
    "singularName": "artwork-group",
    "pluralName": "artwork-groups",
    "displayName": "artwork group"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "sortOrder": {
      "type": "integer"
    },
    "displayMode": {
      "type": "enumeration",
      "enum": ["grid", "immersive", "hero"],
      "default": "grid",
      "required": true
    },
    "boostedArtworks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::artwork.artwork"
    },
    "artworks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::artwork.artwork",
      "mappedBy": "groups"
    }
  }
}
